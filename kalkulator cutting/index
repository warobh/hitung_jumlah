<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator Stiker Multi-Bentuk (32x48 cm)</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #f1f5f9; padding: 20px; display: flex; justify-content: center; }
        .card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); width: 100%; max-width: 500px; }
        h2 { color: #0f172a; margin-top: 0; font-size: 20px; text-align: center; border-bottom: 2px solid #2563eb; padding-bottom: 10px; }
        .form-group { margin-bottom: 15px; }
        label { display: block; font-weight: 600; margin-bottom: 5px; color: #334155; font-size: 14px; }
        input, select { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; }
        input:focus, select:focus { outline: none; border-color: #2563eb; }
        .row-inputs { display: flex; gap: 10px; }
        .row-inputs .form-group { flex: 1; }
        button { width: 100%; background: #2563eb; color: white; border: none; padding: 12px; font-size: 16px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: 0.2s; margin-top: 10px; }
        button:hover { background: #1d4ed8; }
        .result-box { margin-top: 20px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 15px; }
        .result-item { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; color: #334155; }
        .result-item strong { color: #0f172a; }
        .highlight { font-size: 16px; font-weight: bold; color: #16a34a; border-top: 1px solid #cbd5e1; padding-top: 8px; margin-top: 8px; }
        .info-note { font-size: 12px; color: #64748b; margin-top: 4px; }
    </style>
</head>
<body>

<div class="card">
    <h2>Kalkulator Stiker (32 x 48 cm)</h2>
    
    <div class="form-group">
        <label for="bentuk">Bentuk Stiker:</label>
        <select id="bentuk" onchange="toggleBentuk()">
            <option value="bulat">Bulat / Ring / Kubah (Diameter)</option>
            <option value="persegi">Kotak / Persegi Panjang / Oval (Panjang x Lebar)</option>
        </select>
    </div>

    <!-- Input Ukuran Bulat -->
    <div id="groupBulat" class="form-group">
        <label for="diameter">Diameter Stiker (cm):</label>
        <input type="number" id="diameter" placeholder="Contoh: 4" step="0.1" min="0.5">
    </div>

    <!-- Input Ukuran Persegi / Custom -->
    <div id="groupPersegi" class="row-inputs" style="display: none;">
        <div class="form-group">
            <label for="panjang">Panjang (cm):</label>
            <input type="number" id="panjang" placeholder="Contoh: 6" step="0.1" min="0.5">
        </div>
        <div class="form-group">
            <label for="lebar">Lebar (cm):</label>
            <input type="number" id="lebar" placeholder="Contoh: 4" step="0.1" min="0.5">
        </div>
    </div>

    <div class="form-group" id="groupLayout">
        <label for="layout">Metode Layout:</label>
        <select id="layout">
            <option value="interlocking">Selang-Seling / Zigzag (Interlocking - Hemat)</option>
            <option value="grid">Lurus Sejajar (Grid)</option>
        </select>
    </div>

    <div class="row-inputs">
        <div class="form-group">
            <label for="gap">Jarak/Gap (cm):</label>
            <input type="number" id="gap" value="0.2" step="0.1" min="0">
            <div class="info-note">*Sisa antar potong (bleeding)</div>
        </div>
        <div class="form-group">
            <label for="targetPcs">Pesanan (Pcs):</label>
            <input type="number" id="targetPcs" placeholder="Contoh: 500" min="1">
        </div>
    </div>

    <button onclick="hitungStiker()">Hitung Kebutuhan</button>

    <div class="result-box" id="hasilBox" style="display: none;">
        <div class="result-item">
            <span>Bentuk / Ukuran:</span>
            <strong id="resUkuran">-</strong>
        </div>
        <div class="result-item">
            <span>Estimasi per Lembar:</span>
            <strong id="resPerLembar">-</strong>
        </div>
        <div class="result-item highlight">
            <span>Kebutuhan Kertas:</span>
            <strong id="resLembarKertas">-</strong>
        </div>
        <div class="result-item">
            <span>Total Stiker Didapat:</span>
            <strong id="resTotalStiker">-</strong>
        </div>
    </div>
</div>

<script>
function toggleBentuk() {
    const bentuk = document.getElementById('bentuk').value;
    const groupBulat = document.getElementById('groupBulat');
    const groupPersegi = document.getElementById('groupPersegi');
    const groupLayout = document.getElementById('groupLayout');

    if (bentuk === 'bulat') {
        groupBulat.style.display = 'block';
        groupPersegi.style.display = 'none';
        groupLayout.style.display = 'block';
    } else {
        groupBulat.style.display = 'none';
        groupPersegi.style.display = 'flex';
        groupLayout.style.display = 'none'; // Untuk persegi selalu menggunakan layout grid teroptimasi
    }
}

function hitungStiker() {
    const bentuk = document.getElementById('bentuk').value;
    const mode = document.getElementById('layout').value;
    const gap = parseFloat(document.getElementById('gap').value) || 0;
    const targetPcs = parseInt(document.getElementById('targetPcs').value) || 0;

    // Ukuran area cetak efektif (dikurangi margin regmark/crop mark)
    const W = 30; // cm
    const H = 45; // cm

    let pcsPerLembar = 0;
    let labelUkuran = "";

    if (bentuk === 'bulat') {
        const d = parseFloat(document.getElementById('diameter').value);
        if (!d || d <= 0) { alert("Masukkan diameter stiker!"); return; }
        
        labelUkuran = `Bulat Dia. ${d} cm`;
        const effD = d + gap; // Diameter + Jarak antar stiker

        if (mode === 'grid') {
            const col = Math.floor((W + gap) / effD);
            const row = Math.floor((H + gap) / effD);
            pcsPerLembar = col * row;
        } else {
            // Layout Selang-Seling (Interlocking Hexagonal)
            const rowHeight = effD * (Math.sqrt(3) / 2);
            
            // Portrait
            const colOddP = Math.floor((W + gap) / effD);
            const colEvenP = Math.floor(((W + gap) - (effD / 2)) / effD);
            const totalRowsP = Math.floor(((H + gap) - effD) / rowHeight) + 1;
            let countP = 0;
            for (let r = 0; r < totalRowsP; r++) countP += (r % 2 === 0) ? colOddP : colEvenP;

            // Landscape
            const colOddL = Math.floor((H + gap) / effD);
            const colEvenL = Math.floor(((H + gap) - (effD / 2)) / effD);
            const totalRowsL = Math.floor(((W + gap) - effD) / rowHeight) + 1;
            let countL = 0;
            for (let r = 0; r < totalRowsL; r++) countL += (r % 2 === 0) ? colOddL : colEvenL;

            pcsPerLembar = Math.max(countP, countL);
        }

    } else { // Bentuk Persegi / Kotak / Custom
        const p = parseFloat(document.getElementById('panjang').value);
        const l = parseFloat(document.getElementById('lebar').value);
        if (!p || !l || p <= 0 || l <= 0) { alert("Masukkan panjang dan lebar stiker!"); return; }

        labelUkuran = `${p} x ${l} cm`;
        const effP = p + gap;
        const effL = l + gap;

        // Opsi 1: Posisi Standar (Panjang searah Lebar Kertas)
        const col1 = Math.floor((W + gap) / effP);
        const row1 = Math.floor((H + gap) / effL);
        const total1 = col1 * row1;

        // Opsi 2: Posisi Diputar 90 Derajat (Landscape/Rotated)
        const col2 = Math.floor((W + gap) / effL);
        const row2 = Math.floor((H + gap) / effP);
        const total2 = col2 * row2;

        // Ambil hasil tata letak paling efisien (terbanyak)
        pcsPerLembar = Math.max(total1, total2);
    }

    // Hitung Kebutuhan Kertas
    let lembarDibutuhkan = 0;
    let totalDapat = 0;

    if (targetPcs > 0 && pcsPerLembar > 0) {
        lembarDibutuhkan = Math.ceil(targetPcs / pcsPerLembar);
        totalDapat = lembarDibutuhkan * pcsPerLembar;
    }

    // Tampilkan Hasil
    document.getElementById('resUkuran').innerText = labelUkuran;
    document.getElementById('resPerLembar').innerText = pcsPerLembar + ' pcs / lembar';
    document.getElementById('resLembarKertas').innerText = targetPcs > 0 ? lembarDibutuhkan + ' Lembar (32x48 cm)' : 'Masukkan total pcs';
    document.getElementById('resTotalStiker').innerText = targetPcs > 0 ? totalDapat + ' pcs' : '-';
    
    document.getElementById('hasilBox').style.display = 'block';
}
</script>

</body>
</html>
